{
  "name": "sigma-people-demo",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @sigma/web dev",
    "build": "yarn workspace @sigma/ui-kit build && yarn workspace @sigma/web build",
    "preview": "yarn workspace @sigma/web preview",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "fsd:check": "node scripts/check-architecture.mjs",
    "lint": "eslint . && yarn fsd:check",
    "check": "yarn lint && yarn typecheck && yarn build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.6.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.3.2",
    "vue-eslint-parser": "10.2.0"
  }
}
